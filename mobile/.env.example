# URL API utilisée en développement mobile.
# Exemple Android émulateur : http://10.0.2.2:5000/api
# Exemple LAN : http://192.168.1.10:5000/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# DEV SEULEMENT — mettre false en production (HTTPS obligatoire)
# EXPO_PUBLIC_ALLOW_CLEARTEXT=true  ← décommenter uniquement en dev local HTTP
EXPO_PUBLIC_ALLOW_CLEARTEXT=false