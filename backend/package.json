{
  "name": "tekkipro-backend",
  "version": "1.0.0",
  "description": "Tekkipro - SaaS de gestion de boutique pour l'Afrique",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "smtp:verify": "node scripts/verify-smtp.js",
