generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  GRATUIT
  PRO
  BUSINESS
}

enum Role {
  ADMIN
  EMPLOYE
}

enum ModePaiement {
  CASH
  MOBILE_MONEY
  CREDIT
}

enum StatutVente {
  COMPLETEE
  EN_CREDIT
  ANNULEE
}

enum StatutDette {
  EN_COURS
  PAYEE
}

enum StatutAbonnement {
  ACTIF
  EXPIRE
  ANNULE
}

enum ModePaiementAbo {
  WAVE
  ORANGE_MONEY
  FREE_MONEY
  VIREMENT
  CASH
  STRIPE
  PAYPAL
}

enum StatutPaiement {
  EN_ATTENTE
  CONFIRME
  ECHOUE
  REMBOURSE
}

model Boutique {
  id          Int      @id @default(autoincrement())
  nom         String
  adresse     String?
  telephone   String?
  email       String?  @unique
  logo        String?
  ninea       String?
  plan        Plan     @default(GRATUIT)
  slug        String   @unique
  devise      String   @default("FCFA")
  parentBoutiqueId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentBoutique Boutique?  @relation("BoutiqueChildren", fields: [parentBoutiqueId], references: [id])
  childBoutiques Boutique[] @relation("BoutiqueChildren")

  users        User[]
  produits     Produit[]
  categories   Categorie[]
  ventes       Vente[]
  clients      Client[]
  fournisseurs Fournisseur[]
  entreeStocks EntreeStock[]
  abonnements  Abonnement[]

  @@map("boutiques")
}

model User {
  id                    Int      @id @default(autoincrement())
  nom                   String
  prenom                String
  email                 String   @unique
  password              String
  telephone             String?
  role                  Role     @default(EMPLOYE)
  actif                 Boolean  @default(true)
  emailVerifie          Boolean  @default(false)
  tokenVerification     String?  @unique
  tokenVerificationExp  DateTime?
  tokenResetPassword    String?  @unique
  tokenResetPasswordExp DateTime?
  boutiqueId            Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  boutique    Boutique @relation(fields: [boutiqueId], references: [id])
  ventes      Vente[]

  @@map("users")
}

model Categorie {
  id          Int       @id @default(autoincrement())
  nom         String
  boutiqueId  Int
  createdAt   DateTime  @default(now())

  boutique    Boutique  @relation(fields: [boutiqueId], references: [id])
  produits    Produit[]

  @@unique([nom, boutiqueId])
  @@map("categories")
}

model Produit {
  id              Int      @id @default(autoincrement())
  nom             String
  description     String?
  prixVente       Float    @default(0)
  prixAchat       Float    @default(0)
  stock           Float    @default(0)
  stockAlerte     Float    @default(0)
  uniteBase       String   @map("unite")
  codeBarre       String?
  image           String?
  actif           Boolean  @default(true)
  categorieId     Int?
  fournisseurId   Int?
  boutiqueId      Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categorie    Categorie?   @relation(fields: [categorieId], references: [id])
  fournisseur  Fournisseur? @relation(fields: [fournisseurId], references: [id])
  boutique     Boutique     @relation(fields: [boutiqueId], references: [id])
  unitesVente  UniteVente[]
  venteDetails VenteDetail[]
  entreeStocks EntreeStock[]

  @@map("produits")
}

model UniteVente {
  id                Int      @id @default(autoincrement())
  nom               String
  facteurConversion Float
  prix              Float
  prixAchat         Float?
  estDefaut         Boolean  @default(false)
  produitId         Int
  createdAt         DateTime @default(now())

  produit Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)

  @@map("unites_vente")
}

model Client {
  id          Int      @id @default(autoincrement())
  nom         String
  prenom      String?
  telephone   String?
  adresse     String?
  boutiqueId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  boutique    Boutique @relation(fields: [boutiqueId], references: [id])
  ventes      Vente[]
  dettes      Dette[]

  @@map("clients")
}

model Fournisseur {
  id          Int      @id @default(autoincrement())
  nom         String
  telephone   String?
  adresse     String?
  email       String?
  boutiqueId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  boutique     Boutique @relation(fields: [boutiqueId], references: [id])
  produits     Produit[]
  entreeStocks EntreeStock[]

  @@map("fournisseurs")
}

model Vente {
  id              Int          @id @default(autoincrement())
  numero          String       @unique
  montantTotal    Float
  montantPaye     Float        @default(0)
  modePaiement    ModePaiement @default(CASH)
  statut          StatutVente  @default(COMPLETEE)
  clientId        Int?
  userId          Int
  boutiqueId      Int
  createdAt       DateTime     @default(now())

  client   Client?      @relation(fields: [clientId], references: [id])
  user     User         @relation(fields: [userId], references: [id])
  boutique Boutique     @relation(fields: [boutiqueId], references: [id])
  details  VenteDetail[]
  dette    Dette?

  @@map("ventes")
}

model VenteDetail {
  id           Int      @id @default(autoincrement())
  quantite     Float
  prixUnitaire Float
  sousTotal    Float
  uniteNom     String?  @map("nomFraction")
  quantiteBase Float?
  venteId      Int
  produitId    Int

  vente   Vente   @relation(fields: [venteId], references: [id], onDelete: Cascade)
  produit Produit @relation(fields: [produitId], references: [id])

  @@map("vente_details")
}

model Dette {
  id              Int         @id @default(autoincrement())
  montantTotal    Float
  montantPaye     Float       @default(0)
  montantRestant  Float
  statut          StatutDette @default(EN_COURS)
  clientId        Int
  venteId         Int         @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  client         Client        @relation(fields: [clientId], references: [id])
  vente          Vente         @relation(fields: [venteId], references: [id], onDelete: Cascade)
  remboursements Remboursement[]

  @@map("dettes")
}

model Remboursement {
  id          Int      @id @default(autoincrement())
  montant     Float
  detteId     Int
  createdAt   DateTime @default(now())

  dette       Dette    @relation(fields: [detteId], references: [id], onDelete: Cascade)

  @@map("remboursements")
}

model EntreeStock {
  id              Int      @id @default(autoincrement())
  quantite        Float
  quantiteBase    Float?
  prixAchat       Float
  uniteNom        String?
  produitId       Int
  fournisseurId   Int?
  boutiqueId      Int
  createdAt       DateTime @default(now())

  produit     Produit      @relation(fields: [produitId], references: [id])
  fournisseur Fournisseur? @relation(fields: [fournisseurId], references: [id])
  boutique    Boutique     @relation(fields: [boutiqueId], references: [id])

  @@map("entree_stocks")
}

model Abonnement {
  id              Int               @id @default(autoincrement())
  plan            Plan
  statut          StatutAbonnement  @default(ACTIF)
  dateDebut       DateTime          @default(now())
  dateFin         DateTime
  montant         Float
  boutiqueId      Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  boutique        Boutique          @relation(fields: [boutiqueId], references: [id])
  paiements       PaiementAbonnement[]

  @@map("abonnements")
}

model PaiementAbonnement {
  id              Int              @id @default(autoincrement())
  montant         Float
  modePaiement    ModePaiementAbo
  statut          StatutPaiement   @default(EN_ATTENTE)
  reference       String?
  telephone       String?
  stripeSessionId String?          @unique
  stripePaymentId String?
  abonnementId    Int
  createdAt       DateTime         @default(now())

  abonnement      Abonnement       @relation(fields: [abonnementId], references: [id], onDelete: Cascade)

  @@map("paiements_abonnement")
}