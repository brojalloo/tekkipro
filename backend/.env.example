NODE_ENV=development
PORT=5000

# Base de données
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tekkipro?schema=public

# Authentification
JWT_SECRET=replace_me_with_a_long_random_secret_of_at_least_32_chars
JWT_EXPIRES_IN=7d

# URLs publiques
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
TRUST_PROXY=false

# Limites de payload
JSON_BODY_LIMIT=100kb
URLENCODED_BODY_LIMIT=100kb

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT_MAX=5
PAYMENT_WRITE_RATE_LIMIT_WINDOW_MS=300000
PAYMENT_WRITE_RATE_LIMIT_MAX=10
PAYMENT_READ_RATE_LIMIT_WINDOW_MS=300000
PAYMENT_READ_RATE_LIMIT_MAX=60

# SMTP (laisser vide en dev si non utilisé)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TekkiPro <noreply@example.com>

# Paiements
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_KEY=